{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions"],
  "github-actions": {
    "fileMatch": ["\\{\\{cookiecutter\\.project_slug\\}\\}/\\.github/workflows/[^/]+\\.ya?ml$"]
  },
  "packageRules": [
    { "matchUpdateTypes": ["patch", "minor", "major"], "automerge": true }
  ],
  "platformAutomerge": true
}
